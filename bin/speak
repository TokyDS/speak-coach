#!/usr/bin/env bash
# Обёртка: запускает speak из venv проекта, откуда бы её ни вызвали (в т.ч. через симлинк).
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
exec "$root/.venv/bin/python" -m speak "$@"
